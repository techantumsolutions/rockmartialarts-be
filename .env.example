# Cron (same host): POST /api/reg-checkout/cron/renewal-reminders with JSON {"secret":"<REG_CHECKOUT_CRON_SECRET>"}
# e.g. daily: 0 9 * * * curl -sS -X POST https://YOUR_DOMAIN/api/reg-checkout/cron/renewal-reminders -H "Content-Type: application/json" -d '{"secret":"..."}'
# Sends SMS to active registrations whose end_date is within the next 7 days (once per subscription via renewal_reminder_sent).
# If true, send-otp still returns 200 when the SMS gateway fails (local dev only). Omit in production.
# REG_CHECKOUT_ALLOW_SMS_STUB=true

# SMS (registration checkout: OTP, payment welcome, renewal cron)
# Loaded only by rockmartialarts-be (server.py). The Next.js app does not send SMS.
#
# Rock Academy / smslogin.co (GET api.php) — set:
#   SMS_PROVIDER=smslogin
#   SMS_API_URL=https://smslogin.co/v3/api.php   (base URL only; do not paste ?username=… examples)
#   SMS_USERNAME=     (portal username, e.g. Rockacademy)
#   SMS_API_KEY=      (apikey from provider)
#   SMS_SENDER_ID=    (senderid / header, e.g. RMAACD)
#   DLT_OTP_TEMPLATE_ID = DLT template id from portal (digits/id), NOT the message text
#   DLT_OTP_MESSAGE = approved OTP body with %s for the code (must match DLT registration)
#   DLT_WELCOME_TEMPLATE_ID, DLT_REMINDER_TEMPLATE_ID, DLT_PAYMENT_TEMPLATE_ID = ids for each SMS type (register matching text in DLT)
#   DLT_TRANSACTIONAL_TEMPLATE_ID = optional single id used when the specific template id above is empty (same message rules)
#   If those are empty, code falls back to DLT_OTP_TEMPLATE_ID — then your DLT_*_MESSAGE must match that OTP template text.
#   DLT_WELCOME_MESSAGE / DLT_PAYMENT_MESSAGE / DLT_REMINDER_MESSAGE = optional Python %(name)s etc. (must match DLT-approved wording)
#   Legacy DLT_TEMPLATE_* vars are only used as template ids if they look like ids (no %, short)
#
# Other providers:
#   SMS_PROVIDER=json  → POST JSON to SMS_API_URL. Optional: SMS_AUTH_STYLE=bearer|authkey|x-api-key
#   SMS_PROVIDER=msg91 → MSG91 sendhttp; SMS_API_KEY=authkey, SMS_SENDER_ID=sender
#   SMS_PROVIDER=form  → POST form to SMS_API_URL; optional SMS_FORM_* field names
SMS_PROVIDER=smslogin
SMS_API_URL=https://smslogin.co/v3/api.php
SMS_USERNAME=
SMS_API_KEY=
SMS_SENDER_ID=
DLT_OTP_TEMPLATE_ID=
DLT_OTP_MESSAGE=
DLT_TEMPLATE_OTP=
DLT_TEMPLATE_WELCOME=
# Optional second SMS after successful payment (receipt-style). Leave empty to skip.
DLT_TEMPLATE_PAYMENT_CONFIRMED=
DLT_TEMPLATE_REMINDER=
DLT_WELCOME_TEMPLATE_ID=
DLT_REMINDER_TEMPLATE_ID=
DLT_PAYMENT_TEMPLATE_ID=
