# Copy to .env and fill in real values. Do not commit secrets.

# --- Branch Distance Configuration ---
# Distance calculation mode: routing | straight_line
BRANCH_DISTANCE_MODE=routing

# Configurable routing provider (currently: google)
BRANCH_DISTANCE_PROVIDER=google

# Server-side Google Maps / Distance Matrix API key (NEVER expose as NEXT_PUBLIC_*)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY_HERE

# Optional: only if branch address geocoding is required
GOOGLE_GEOCODING_API_KEY=YOUR_GOOGLE_GEOCODING_API_KEY_HERE

# Optional override for Distance Matrix endpoint (defaults to Google Distance Matrix)
BRANCH_DISTANCE_API_BASE_URL=

# Distance calculation cache TTL in seconds (rounded origin cache; not precise GPS)
BRANCH_DISTANCE_CACHE_TTL=300
